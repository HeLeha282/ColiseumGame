# Нормализация переводов строк для текстовых файлов
* text=auto

# Текстовые файлы Unity (YAML) — храним как текст
*.cs        text diff=csharp
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.meta      text
*.anim      text
*.controller text
*.json      text
*.shader    text
*.shadergraph text
*.shadersubgraph text
*.inputactions text
*.asmdef    text
*.asmref    text
*.mixer     text
*.physicMaterial text
*.lighting  text
*.overrideController text
*.mask      text
*.playable  text
*.signal    text
*.preset    text
*.uss       text
*.uxml      text

# Запечённая сетка навигации Unity хранится в бинарном формате.
/Assets/_Project/Scenes/Prototype_NavMesh.asset -text

